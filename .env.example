# Madde 44 — Sırlar burada, kodda DEĞİL. Bu dosyayı .env olarak kopyala.

# Veri sağlayıcı: yfinance (ücretsiz/~15dk gecikmeli) | tradingview (unofficial) | alpaca (gerçek-zamanlı)
DATA_PROVIDER=yfinance

# TradingView (opsiyonel; sadece DATA_PROVIDER=tradingview ise kullanılır)
# Boş bırakırsan anonim/delayed; girersen TV plan'ına göre real-time.
TV_USERNAME=
TV_PASSWORD=
# Sembol → exchange override (varsayılan eşleme tv_provider.py'da). Format: AAPL:NASDAQ,SPY:AMEX
TV_EXCHANGE_MAP=

# Alpaca Market Data (GERÇEK-ZAMANLI; IEX feed ücretsiz). DATA_PROVIDER=alpaca için.
# Ücretsiz key: https://alpaca.markets → Paper hesabı → API Keys. `pip install alpaca-py`
# Opsiyon zinciri Alpaca'da paylı → otomatik yfinance'e düşer (FailoverProvider).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex                    # iex (ücretsiz gerçek-zamanlı) | sip (paylı, tam piyasa)
# --- Tur-57'de ÖLÇÜLDÜ (2026-08-29, ÜCRETSİZ anahtarla) ---------------------------
# SIP *tarihsel* barlar ücretsiz planda ZATEN yetkili; kapalı olan yalnız son 15 dakika.
# IEX barları konsolide hacmin %2,2-3,4'ünü görüyor (AAPL/SPY/NVDA) → hacim tabanlı her
# ölçü IEX'te ~30 kat küçük ölçülür. AMA SIP barları uzatılmış seansı da içerir
# (5dk: 225 bar ↔ IEX 81) → BAR KÜMESİ değişir, göstergeler değişir. Bu yüzden ayrı ve
# opt-in bir anahtar: yalnız BAR çekimi bunu kullanır, kotasyon ALPACA_FEED'de kalır
# (SIP anlık kotasyon ücretsiz planda 403 verir). Açmadan önce A/B ölç.
ALPACA_BARS_FEED=                  # boş = ALPACA_FEED ile aynı | sip = tam konsolide hacim
# Opsiyon zinciri yfinance TABANI üstüne Alpaca OPRA (canlı NBBO + IV + greekler) işler.
# Zincir başına 1 ek istek → tarama döngüsüne gecikme ekler; varsayılan KAPALI.
ALPACA_OPTIONS=off                 # 1/true/on = OPRA zenginleştirmesi açık
# SHORT sinyalinde borç bayrağı (Madde 30'un ikinci yarısı). Varsayılan: İŞARETLER.
SHORT_BORROW_GUARD=notice          # notice = yalnız gerekçe yaz | block = sinyali durdur
# Madde 25 (Tur-58) — ex-temettü öncesi ITM LONG CALL'ın erken-kullanım eşiği.
# Ex-tarihte dayanak ≈D düşer; uzun call temettüyü ALMAZ → ekstrinsik < D olduğu anda
# "erken kullan ya da temettüyü yitir" ikilemi doğar. Varsayılan İŞARETLER (kontrat
# seçiminde gerekçe + açık pozisyonda uyarı); `block` gerçek bir kapıya/çıkışa çevirir.
# Temettü TUTARI okunamazsa eşik sezgisele düşer ve gerekçe `_UNMEASURED` taşır.
EXDIV_GUARD=notice                 # notice = yalnız işaretle | block = kapı/çıkış

# Alpaca REST hız BÜTÇESİ (Tur-58; nihai/observability.py + pano /metrics).
# Ölçülen çağrı/dk yumuşak tavanı aşarsa tarama döngüsüne oransal uyku EKLENİR;
# tavanın ALTINDA ek uyku TAM 0.0'dır (davranış bit-denk, testle kilitli).
ALPACA_RATE_LIMIT_PER_MIN=200      # hesap planının dakika limiti
ALPACA_RATE_SOFT_PCT=80            # limitin yüzde kaçında fren devreye girsin

# NTP SAAT KAYMASI ÖNBELLEĞİ (Tur-75, Madde 242). `/metrics` saat kaymasını
# ÖNBELLEKTEN okur; ölçmek AYRI ve bilinçli bir adımdır
# (`observability.refresh_clock_drift()` ya da `python -m nihai.audit_chain --clock`).
# Bu TTL dolmadan yeniden ÖLÇÜLMEZ — okuma yolu bir UDP turu ödeyemez (BULGU-59-8).
# Hiç ölçülmemişse `/metrics`te nihai_clock_* satırları HİÇ basılmaz (0 ≠ "ölçüm yok").
CLOCK_DRIFT_TTL_SEC=3600           # saniye; ölçüm bu yaştan tazeyse yeniden ölçme

# SHA-256 KARAR ZİNCİRİ (Tur-75 yazdı · Tur-76 canlı yola BAĞLADI, Madde 244).
# `on` (varsayılan): KABUL EDİLEN sinyal ve KAPANAN işlem `data/audit_chain.jsonl`e
# halka olarak eklenir; bütünlük `/api/system/health` → `audit_chain` alanında okunur.
# HER karar satırı YAZILMAZ (tek günlük decision_log 35 MB'a çıkıyor — Tur-58 ölçümü).
# İDDİANIN SINIRI: zincir kazara bozulmayı ve SEÇİCİ DÜZENLEMEYİ yakalar; dosyaya yazma
# yetkisi olan kötü niyetli bir yazara karşı kanıt DEĞİLDİR (bunun için `merkle_root`
# DIŞARI taşınmalıdır). `off` kapatır.
AUDIT_CHAIN=on                     # on|off

# logs/ SIKIŞTIRMA bandı (Tur-58). Bu yaştan eski ama LOG_RETENTION_DAYS'i aşmamış
# dosyalar gzip'lenir; ölçüldü: gerçek karar günlüklerinde 82,4 → 5,5 MB (×15,1).
# Kazanç yalnız disk değil OneDrive yükleme bandıdır. Uygula: python -m nihai.log_retention --apply
LOG_COMPRESS_DAYS=7

# Sharadar / Nasdaq Data Link (ÜCRETLİ; survivorship'siz point-in-time backtest için).
# SADECE araştırma katmanı kullanır (research/smallcap_momentum.py, nihai/data/sharadar.py);
# canlı sinyal/quote VERMEZ. Boşsa o araçlar net kurulum yönergesi gösterip çıkar (çökmez).
# Kurulum: pip install nasdaq-data-link · data.nasdaq.com → Sharadar Equity Bundle (~$30-50/ay)
NASDAQ_DATA_LINK_API_KEY=

# DoltHub opsiyon veritabanı (ÜCRETSİZ, anahtar YOK) — nihai/data/dolt_options.py
# post-no-preference/options: 2019-02-09→bugün, 2321 sembol. İki tablo:
#   volatility_history → iv_current/iv_year_high/iv_year_low = HAZIR IV Rank
#   option_chain       → gerçek bid/ask + tam greeks (backtest'in sentetik BS'i yerine)
# Dolt SÜRÜMLÜDÜR: as_of="HEAD~50" gerçek point-in-time okuma verir (survivorship'siz).
# Toplu CSV 217 MB'dır; DATA_DIR OneDrive altındaysa senkron yükünü almak için taşıyın.
# DOLT_CACHE_DIR=D:\dolt_cache
# DOLT_POLITE_DELAY_SEC=2.0        # SQL API kipinde semboller arası bekleme
# DOLT_RATE_LIMIT_SLEEP_SEC=60     # 403 gelince beklenecek süre

# CBOE volatilite endeksleri (ÜCRETSİZ, anahtar YOK) — nihai/data/cboe_data.py
# VIX/VIX9D/VIX3M/VIX6M/VVIX/SKEW günlük, VIX 1990'dan bugüne. Endeks düzeyi olduğu
# için survivorship YAPISI GEREĞİ yoktur; rejim/koşullama özelliği olarak kullanılır.
# CBOE_CACHE_MAX_AGE_DAYS=1

# Telegram (opsiyonel — boş bırakırsan terminal/web çalışır, Telegram sessiz olur)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8765
# CORS izinli origin'ler (virgülle ayrılmış). Boş bırakılırsa localhost:WEB_PORT varsayılanı.
# Uzaktan erişim için açık adres ekleyin. "*" verilirse credentials otomatik kapanır.
# WEB_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Çalışma kipi: SIMULATION (kâğıt), BACKTEST, LIVE_SIGNALS (canlı ama sadece sinyal)
RUN_MODE=LIVE_SIGNALS

# Sinyal kipi: stock | option | both
OPTION_MODE=stock

# Aktif strateji: event_breakout | mean_reversion | rsi_divergence | macd | donchian |
#                 squeeze | trend_pullback | vol_breakout | pead | insider | sentiment |
#                 ensemble (ilk-tetik/oylama) | confluence (≥N detektör mutabakatı, §16.2) |
#                 quant_trend (Tur-97: günlük çok ufuklu zaman serisi momentumu + σ ölçekli risk;
#                 canlı tarama günlük barları ayrıca çeker, pozisyon çok günlüktür)
# Tur-106: şablon ölçülmemiş `ensemble`ı öneriyordu; canlı karar ve ölçüm (Tur-97 karnesi) quant_trend.
# quant_trend'de oto-tarayıcı (1h backtest) atlanır — strateji o aralıkta işlem üretmez (BULGU-106-4).
ACTIVE_STRATEGY=quant_trend

# Sermaye (sanal portföy — canlı emir yok)
INITIAL_EQUITY=25000

# Watchlist (virgülle) — yalnızca OTO-TARAYICI'nın başlangıç tohumu.
# Asıl canlı liste data/watchlist.json'da tutulur ve tarama ile dinamik güncellenir.
WATCHLIST=AAPL,MSFT,SPY,NVDA,TSLA,QQQ

# --- Oto-tarayıcı (dinamik watchlist) ---
# Sistem evreni kendisi tarar, en iyi N adayı canlı watchlist'e koyar (top-N dinamik).
AUTO_SCREEN_ENABLED=true
AUTO_SCREEN_UNIVERSE=both          # nasdaq100 | sp500 | both
AUTO_SCREEN_INTERVAL_MINUTES=5     # tarama bittikten sonra bir sonrakine kadar boşta bekleme (dk)
AUTO_SCREEN_TOP_N=20               # watchlist'e konacak en iyi N sembol (0 = HEPSİ: tüm evreni tara)
AUTO_SCREEN_INTERVAL=1h            # tarama backtest bar aralığı
AUTO_SCREEN_PERIOD=6mo             # tarama backtest dönemi
AUTO_SCREEN_SORT=expectancy        # expectancy | sharpe | total_return_pct | win_rate_pct
AUTO_SCREEN_MIN_TRADES=5           # eleme: en az işlem sayısı
AUTO_SCREEN_MIN_EXPECTANCY=0       # eleme: min expectancy
AUTO_SCREEN_MAX_RUIN=0             # eleme: max iflas olasılığı (0=kapalı; >0 için AUTO_SCREEN_MC>0 şart)
AUTO_SCREEN_MC=0                   # sembol başına Monte Carlo iter (ruin filtresi için >0)
AUTO_SCREEN_THROTTLE=0.5           # semboller arası bekleme (sn) — yfinance ban önleme
AUTO_SCREEN_PROVIDER=yfinance      # toplu tarama için yfinance önerilir (tradingview çok yavaş)
AUTO_SCREEN_WRITE_CSV=true          # her taramada sıralamayı logs/auto_screen_<ts>.csv'ye yaz

# --- İki-katman paralel tarama (dual-tier) ---
# En iyi N sembol "odak" katmanında (TradingView), kalan tüm evren "geniş" katmanında
# (yfinance) PARALEL taranır. Ortak portföy/state tek kilitle korunur. Açıkken oto-tarayıcı
# tüm evreni sıralar; canlı döngü taramayı iki thread'e devreder, ana thread pozisyon yönetir.
DUAL_TIER_ENABLED=false            # true → iki-katman paralel mod
FOCUSED_TOP_N=100                  # odak katmanına kaç sembol (en iyiler)
FOCUSED_PROVIDER=tradingview       # odak katman sağlayıcısı
BROAD_PROVIDER=yfinance            # geniş katman sağlayıcısı
FOCUSED_THROTTLE=0                 # odak: semboller arası bekleme (sn)
BROAD_THROTTLE=0.3                 # geniş: semboller arası bekleme (sn) — yfinance ban önleme
TIER_CYCLE_GAP=5                   # bir tur bitince sonraki tura kadar bekleme (sn)

# ===========================================================================
# ÇIKIŞ / RİSK / TARAMA GELİŞTİRMELERİ (A1–B8) — HEPSİ VARSAYILAN KAPALI.
# Açmadan önce bench.py (before/after) veya exit_grid.py ile İKİ periyotta A/B yap;
# bu sistemde kenarların çoğu survivorship/overfit artefaktıdır (docs/EDGE_FINDINGS.md).
# ===========================================================================

# --- A1: Kademeli trailing + kâr-tabanı kilidi (kazananı koştur) ---
TRAIL=false                        # trailing stop'u aç (sabit hedefi kaldırır: TRAIL_DROP_TARGET)
TRAIL_R=2.0                        # düz trailing mesafesi (R; başlangıç riski katı)
TRAIL_DROP_TARGET=true             # trailing açıkken sabit hedefi kaldır
TRAIL_TIERED=false                 # kâr arttıkça trail'i kademeli SIKILAŞTIR (R-uzayı)
TRAIL_TIERS=1.5:2.0,3.0:1.5,5.0:1.0  # 'kâr_R:trail_R' — 5R+ kârda 1.0R (en sıkı)
TRAIL_LOCK_TRIGGER_R=3.0           # kâr bu R'yi aşınca tabanı kilitle (0=kapalı)
TRAIL_LOCK_FLOOR_R=1.0             # kilit: stop ≥ entry + bu R

# --- A2: MFE give-back (zafer-kaçırma) koruması — R-tabanlı ---
MFE_GIVEBACK=false                 # tepe lehte hareketten geri-veriş çıkışı
MFE_GIVEBACK_ARM_R=1.5             # MFE bu R'yi aşınca armlanır
MFE_GIVEBACK_R=1.0                 # tepeden bu kadar R geri verilince çık

# --- Breakeven (mevcut; tamlık için) ---
BREAKEVEN=false                    # fiyat +BE_TRIGGER_R gidince stop'u girişe çek
BE_TRIGGER_R=1.0
BE_BUFFER_R=0.0

# --- A3: Kill-switch (rolling expectancy) + otomatik reset ---
ENABLE_KILL_SWITCH=false           # son N işlem ort. PnL < 0 → yeni giriş dur
KILL_SWITCH_MIN_TRADES=30          # değerlendirmeye başlamak için min işlem (pencere=50)
KILL_SWITCH_RESET_EXPECTANCY=0.0   # expectancy bu eşiğe (≥) toparlayınca kilit kalkar

# --- A4: Piyasa rejimi → risk çarpanı (benchmark GÜNLÜK trendi ± VIX) ---
REGIME_RISK=false                  # rejim çarpanını sizing'e uygula (backtest+canlı)
REGIME_BENCHMARK=SPY               # rejim referansı
REGIME_INTERVAL=1d                 # benchmark bar aralığı (rejim GÜNLÜK konsept)
REGIME_REFRESH_MIN=60              # canlıda kaç dk'da bir yeniden hesapla
REGIME_DEFENSIVE_RET=-5.0          # benchmark 20-bar getirisi < bu % → DEFENSIVE
REGIME_DEFENSIVE_MULT=0.5          # DEFENSIVE risk çarpanı
REGIME_NEUTRAL_MULT=0.8            # NEUTRAL risk çarpanı
REGIME_BULLISH_MULT=1.0            # BULLISH risk çarpanı
REGIME_VIX_HIGH=28                 # (opsiyonel) VIX ≥ bu → DEFENSIVE
REGIME_VIX_LOW=16

# --- B1: FRED makro risk-off kapısı (rejim+drawdown ile ÇARPIMSAL; VARSAYILAN KAPALI) ---
# Ücretsiz FRED key: https://fred.stlouisfed.org/docs/api/api_key.html
MACRO_GATE=false                   # true → makro risk-off çarpanını sizing'e uygula
FRED_API_KEY=                      # boşsa kapı otomatik devre-dışı (çarpan 1.0)
MACRO_REFRESH_MIN=360              # makro yavaş → 6 saatte bir çek (önbellekli)
MACRO_VIX_HIGH=28                  # VIXCLS ≥ bu → risk-off oyu
MACRO_T10Y2Y_MIN=0.0              # T10Y2Y < bu → ters eğri oyu
MACRO_HY_SPREAD_HIGH=5.0           # BAMLH0A0HYM2 (HY OAS %) ≥ bu → kredi-stres oyu
MACRO_ONE_MULT=0.8                 # 1 tetik → temkin çarpanı
MACRO_MULTI_MULT=0.5               # ≥2 tetik → risk-off çarpanı

# --- C1: SEC EDGAR insider (Form 4) ADAY sinyali — ücretsiz, anahtar YOK ---
# SEC sadece kibar bir User-Agent ister (ad + e-posta). Tek kaynak: bu değişken.
SEC_USER_AGENT=                     # "Ad Soyad eposta@ornek.com" (SEC kuralı)
# BOŞ bırakılırsa SEC/FINRA/Wikimedia istekleri iletişim bilgisi TAŞIMADAN gider:
# SEC 403, Wikimedia politika sayfası döndürür. nihai.net.contact_ua bir kez uyarır.
# BU ANAHTAR ARTIK YALNIZ C1 DEĞİL: Wikipedia evren tazelemesi de (execution/screen.py →
# auto_screener/pit_universe) aynı UA'yı kullanır. Boşken sp500_tickers() BOŞ liste,
# nasdaq100_tickers() BAYAT yedek liste döner → tarama ~600 yerine 101 isme iner
# (sp500_tickers() bunu ERROR olarak kaydeder — dört çağıranın HEPSİ kapsanır; Nasdaq
# yedeğine düşüş ise yalnız WARNING'dir). LOG SATIRI YETMEZ: 7/24 tarayan bir sürecin
# system.log'unda görünmez → kalıcı yüzey /api/system/health → `universe`, panoda
# "Evren Kaynakları" kartı (DEGRADE rozeti). İKİ liste de oradan okunur, yani
# AUTO_SCREEN_UNIVERSE=nasdaq100 kipinde de sessiz daralma görünür.
# ADRES ŞART: "NihaiBot" / "NihaiBot@" gibi ulaşılabilir adresi olmayan bir değer de 403
# alır ve o da uyarılır; e-posta ya da iletişim URL'si ("+https://...") kabul edilir.
SEC_THROTTLE=0.2                   # EDGAR istekleri arası saniye (limit 10/s → ~5/s güvenli)
# Ölçüm: python -m research.insider_test  (ilk koşu yavaş; data/insider_cache'e yazar)

# --- C2: Reddit sentiment ADAY sinyali (PRAW+VADER) — ücretsiz 'script' app ---
# https://www.reddit.com/prefs/apps → "create app" → script → client id/secret al.
# Boşsa modül sessizce devre-dışı (sinyal WAIT). Reddit tarihsel API'si yok → geçmiş
# yalnız İLERİYE birikir (her gün update_sentiment → data/sentiment_history/<SYM>.csv).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NihaiAlgoritma sentiment script
SENTIMENT_SUBREDDITS=wallstreetbets,stocks,investing,StockMarket
# Ölçüm: python -m research.sentiment_test --coverage  (soğuk başlangıçta geçmiş=0 beklenir)

# --- A5: Düşük-güven kademeli boyutlama (az backtest geçmişi → küçük poz) ---
CONFIDENCE_SIZING=false            # watchlist risk_mult'ı sizing'e uygula
CONFIDENCE_COMFORT_TRADES=10       # bu işlem sayısının altı = düşük güven
CONFIDENCE_LOW_MULT=0.5            # düşük güven risk çarpanı

# --- B7/B8: Hibrit tarayıcı skoru (backtest + canlı kurulum) + RS-vs-SPY ---
SCREEN_HYBRID=false                # sıralama z(backtest)+w·z(setup_score)
SCREEN_HYBRID_SETUP_WEIGHT=1.0     # kurulum skorunun ağırlığı
SCREEN_RS_BENCHMARK=SPY            # görel-güç referansı
SCREEN_RS_SHORT_DAYS=21            # RS kısa ufuk (işlem günü ≈ 1 ay)
SCREEN_RS_LONG_DAYS=63             # RS uzun ufuk (işlem günü ≈ 3 ay)
SCREEN_RUNUP_DAYS=3                # kısa "aşırı-uzama tazeliği" ufku (RS'ten ayrı)

# --- Log retention (signal_engine.prune_logs, başlangıçta otomatik) ---
# Rotasyon arşivleri + günlük karar/tarama dosyaları sınırsız birikmesin diye en yeni
# N dosya tutulur (system.log zaten loguru retention'lı). 0 = sınırsız (eski davranış).
LOG_KEEP_TRADE_ARCHIVES=5          # trade_log_*.txt arşiv sayısı (aktif trade_log.txt hariç)
LOG_KEEP_DECISION_LOGS=30          # decision_log_*.txt gün sayısı
LOG_KEEP_SCREEN_CSV=30             # auto_screen_*.csv tarama sayısı

# --- Canlı forecast kapalı-döngü doğrulama (prediction_tracker, #3) ---
# Açıkken predict servisi her bar'ın forecast'ini data/predictions_log.csv'ye yazar.
# Sonra: python -m nihai.execution.prediction_tracker --resolve --report  → canlı isabet/kalibrasyon.
PREDICT_TRACK=false                # true → tahminleri diske kaydet (paper-trade eşdeğeri)
PREDICT_TRACK_HORIZON_BARS=5       # gerçekleşen yön kaç bar ileride ölçülür

# --- Yön girdisi: canlı fiyat mı, karar barının kapanışı mı? (Tur-83: VARSAYILAN AÇIK) ---
# Tur-20 bu anahtarı "sınanmamış hipotez" diye KAPALI kurdu ve iki varyantı da logladı.
# Tur-83 biriken gölgeyi SINADI (43.195 satır / 18 gün, AYNI satırlar, AYNI referans =
# canlı fiyat): isabet canlı-yön %48,20 ↔ bar-yön %50,12 (+1,92 puan, gün-kümeli t=+12,8;
# 18 günün 15'inde bar önde). Fark yönün ayrıştığı %4'lük dilimden gelir: kotasyon bar
# kapanışından sapıp EMA20'nin öbür yanına geçince canlı-yön %26 isabet eder (sapma geri
# döner). Bar-yön de YAZI-TURADIR — bu bir kenar değil, yazı-turanın ALTINDAKİ bir kusurun
# kaldırılmasıdır. true = bar kapanışı (vars.) · false/0/off/no = eski canlı-kotasyon yönü.
# Karşı varyant her kipte `dir_live`/`conf_live` olarak yazılır → A/B aynı satırlarda sürer.
SIGNAL_ON_BAR_CLOSE=true

# --- Canlı tahmin sekmesi (web pano /api/predictions, live_predict_service) ---
# DÜRÜST NOT: 'Olasılık (kal.)' ~%50 ise yön tahmininin öngörü gücü YOKTUR (yazı-tura).
# Bu knob'lar yalnızca tabloyu/yenilemeyi ayarlar; kenar yaratmaz.
# PREDICT_SYMBOLS=AAPL,MSFT,NVDA   # boşsa STREAM_SYMBOLS, o da boşsa universe.BASKET (≤30)
PREDICT_INTERVAL=1h               # boşsa HTF_INTERVAL; tahmin bar zaman dilimi
PREDICT_REFRESH_SEC=20            # tur arası saniye (min 5)
PREDICT_HTF_INTERVAL=15m          # üst-zaman-dilimi onayı (whipsaw filtresi)
PREDICT_REGIME_BENCH=SPY         # piyasa-geneli rejim için benchmark
PREDICT_WORKERS=8                 # paralel sembol hesaplama thread sayısı
PREDICT_CACHE_TTL_SEC=8          # sekmeye özel kısa bar önbelleği (0=kapalı)
PREDICT_QUOTE_MAX_SPREAD=0.005    # quote reddi: bid/ask spread tavanı (%0.5)
PREDICT_QUOTE_MAX_DEV=0.02        # quote reddi: son kapanıştan sapma tavanı (%2)

# --- Çekirdek risk yönetimi (config.py; sanal portföy — canlı emir yok) ---
PER_TRADE_RISK_PCT=0.02           # işlem başına risk (equity oranı)
DAILY_MAX_LOSS_PCT=0.10           # günlük max zarar → yeni girişler durur (0 = KAPALI)
MAX_GROSS_RISK_PCT=1.00           # toplam brüt risk tavanı (risk $ / equity)
MAX_NET_DIRECTIONAL_PCT=2.0       # net yönsel nominal ≤ 2.0×equity
# Pozisyon BAŞINA nominal tavanı $ (Tur-40). 0 = kapalı. RED kapısı DEĞİL BÜYÜKLÜK
# tavanıdır: aday reddedilmez, tavana sığacak şekilde küçültülür → aynı sermaye daha
# çok eşzamanlı pozisyona dağılır. risk_manager ve backtest AYNI alanı okur.
MAX_POSITION_NOTIONAL=0
CONSECUTIVE_STOPS_COOLDOWN=3      # üst üste stop sonrası soğuma (işlem sayısı)
MIN_RR_RATIO=1.2                  # minimum risk/ödül oranı (altı WAIT)
MIN_QUALITY=1.0                   # minimum kurulum kalite skoru (altı WAIT)
META_GATE_THRESHOLD=0             # >0 ise P(win) bu eşiğin altındaki LONG/SHORT'u eler (varsayılan kapalı)

# --- Genel veri / zaman dilimi / önbellek ---
HTF_INTERVAL=1h                   # ana sinyal/analiz zaman dilimi
DATA_CACHE_TTL_SEC=45             # bar önbelleği TTL (sn)
QUOTE_CACHE_TTL_SEC=1.5           # quote önbelleği TTL (sn)
LIVE_SCAN_WORKERS=8               # canlı tarama paralel worker
ENSEMBLE_MODE=first_trigger       # çoklu-strateji birleştirme: first_trigger | ...
CONFLUENCE_MIN_VOTES=2            # ACTIVE_STRATEGY=confluence: min hemfikir detektör (≥2, §16.2)
STREAM_MAX_SYMBOLS=30             # WS abonelik limiti (ücretsiz IEX ~30)

# --- Hub (paylaşılan tek-bağlantı veri sunucusu; run-hub.ps1) ---
HUB_URL=http://127.0.0.1:8799
HUB_HOST=127.0.0.1
HUB_PORT=8799
HUB_UPSTREAM_PROVIDER=alpaca_stream   # hub'ın yukarı-akış veri kaynağı

# --- Akış sembolleri (alpaca_stream / live_predict) ---
# ≤30 sembol (ücretsiz IEX WS limiti). Boşsa erişilen semboller dinamik abone edilir
# (cap'li); live_predict için boşsa universe.BASKET kullanılır.
STREAM_SYMBOLS=

# --- Web pano güvenliği (Madde 44) ---
# Doluysa tüm mutasyon uçları (POST/PUT/DELETE) X-Auth-Token başlığı ister.
# Boşsa koruma YOK (yalnız localhost'ta çalıştırıyorsan kabul edilebilir).
WEB_TOKEN=

# --- Meta-labeling kapısı (nihai/signals/meta_gate.py) ---
# ÜÇ DEĞERLİ: false=off (varsayılan) | shadow (eş: gölge/golge) | true=enforce.
#   shadow → kapı p_win'i HESAPLAR + loglar (meta_p_win/meta_shadow_gated) ama sinyali
#            ASLA bastırmaz: canlı kanıt döngüsü (prediction_tracker pwin → gate_sim/
#            pwin_calibration) kapı fiilen kapalıyken de yaşar.
#   true   → eşik altı sinyal WAIT'e çevrilir. Canlı gate_sim GATE_HURTS derken AÇMA.
# DÜRÜST NOT: PIT S&P500'de OOS-AUC ~0.51 = kenar YOK (EDGE_FINDINGS §16, CLAUDE.md).
# Bu yüzden varsayılan KAPALI; dayanıklı kanıt olmadan enforce'a geçme.
META_GATE=false

# --- IV Rank rejim bonusu (IV_REGIME_BONUS) ------------------------------------------
# `signal_quality_score` IV Rank'e +0.5 verir. Kip:
#   off  → bonus HİÇ verilmez            (VARSAYILAN, Tur-51'den beri)
#   band → 30 <= rank <= 50 ise +0.5     (Tur-51 ÖNCESİ varsayılan; A/B için)
#   low  → rank <= 30 ise +0.5
# DÜRÜST NOT: üç kipin de ölçülmüş desteği YOK. 2026-08-13'te "bant TERS, ilişki MONOTON
# (t=−7,35)" ölçülmüş ve "bonusu çevir" önerilmişti; Tur-51 o sonucun VEKİL ETİKETİN
# artefaktı olduğunu ölçtü (EDGE_FINDINGS §28) — temiz ileri RV ile bant gün-bazlı
# t=−0,17 = AYIRT EDİLEMEZ. `off` bir "ters kenar" iddiası DEĞİL, kanıtsız bir bileşenin
# skordan çıkarılmasıdır. `band` eski davranışa döndürür.
IV_REGIME_BONUS=off

# --- P(win)-oranlı boyutlama (PROB_SIZING; META_GATE'ten bağımsız, modeli yükler) ---
# Canlı veride confidence isabetle TERS korele bulundu → körü körüne açmak kötü
# sinyalleri büyütür. train_meta OOS kapı simülasyonu kenarı kanıtlamadan AÇMA.
PROB_SIZING=false
PROB_SIZING_P_LO=0.45              # bu olasılığın altı taban çarpana iner
PROB_SIZING_P_HI=0.60              # bu olasılığın üstü tam boy
PROB_SIZING_FLOOR=0.25             # taban risk çarpanı

# --- İÇ AI KARAR KÖPRÜSÜ (Tur-38; nihai/execution/ai_advisor.py) ---
# off     : köprü ÖLÜ — decide() bir kez bile çağrılmaz (VARSAYILAN, Tur-37 ile bit-denk)
# advise  : AI görüşü gerekçeye/loga/Telegram metnine yazılır, SONUCU DEĞİŞTİRMEZ
# enforce : ABSTAIN/ters yön → VETO (uyarı + giriş durur); veto yoksa boyutu KISAR
# Yön ÜRETMEZ, boyut BÜYÜTMEZ, ÇIKIŞ yoluna hiç bağlanmaz. Tanınmayan değer → off.
# DÜRÜST NOT: canlı öğrenme durumunda (n=18.099) GLOBAL/LONG/SHORT üçünün de %95 CI
# tabanı 0.5'in ALTINDA → enforce BUGÜN HER SİNYALİ veto eder. Bu kusur değil, ölçüm.
# Tur-92: 14 günde 7.711 canlı adayın 7.711'i ABSTAIN; kapı-b (fayda) o güne dek post=1'de
# bile geçilemiyordu (düzeltildi, BULGU-92-2). Önerilen canlı kip: advise.
AI_LIVE_MODE=off
AI_LIVE_SIZE_P_LO=0.50             # posterior bunun altındaysa taban çarpan
AI_LIVE_SIZE_P_HI=0.60             # posterior bunun üstündeyse tam boy
AI_LIVE_SIZE_FLOOR=0.25            # taban risk çarpanı (0 değil: sinyali öldürmez)
# Verdikt KAYDI kipten BAĞIMSIZDIR: AI_LIVE_MODE=off iken bile predictions_log.csv'ye
# ai_action/ai_post/ai_veto/ai_side kolonları yazılır. Neden: "enforce açılmalı mı?"
# sorusu ancak kapı KAPALIYKEN biriken kayıtla yanıtlanabilir (prediction_tracker.ai_gate_sim).
AI_VERDICT_LOG=on                  # off → ölçüm de durur (aday başına bir decide() tasarrufu)

# --- GÖLGE KÖPRÜSÜ (Tur-60; nihai/execution/shadow_bridge.py) ---
# Gözlemevi (mikroyapı + NEDENSEL rejim HMM + veri sağlığı) ve kovalama sapması bugüne
# kadar YALNIZ live_predict_service'te, yani AYRI bir süreçte koşuyordu; aday sinyali
# ÜRETEN yol onları hiç görmüyordu. Bu köprü o ayrımı kapatır.
# advise  : ölçüler gerekçeye/karar loguna yazılır, KARAR DEĞİŞMEZ (VARSAYILAN)
#           — veto=False / size_mult=1.0 YAPISALDIR, kip bir kenar iddiası taşımaz
# off     : köprü ÖLÜ — tek satır bile çalışmaz (Tur-59 ile bit-denk)
# enforce : yalnız TERFİ ETMİŞ kural karara girer. shadow_promote'ın 2026-08-31 ölçümünde
#           HİÇBİR yüzey kapıyı geçmedi → bu kip bugün de advise gibi davranır ve nedenini
#           bir kez UYARI olarak loglar. Terfi defteri KODDADIR (shadow_bridge.RULES);
#           bir veri dosyası canlı kapının kuralını değiştiremez.
# Yön ÜRETMEZ, boyut BÜYÜTMEZ, ÇIKIŞ yoluna hiç bağlanmaz. Tanınmayan değer → advise.
SHADOW_BRIDGE=advise
# Nöral gölge p_win AYRI bayrak ister: bu çağrı canlı TARAYICI sürecinde torch importunu
# tetikler (Tur-26 import hijyeni). Ölçüm HOLD (+0,1233pp ama tutulan kova n=37) — açmanın
# gerekçesi kenar değil KANIT BİRİKTİRMEKTİR.
SHADOW_BRIDGE_NEURAL=0
# Günlük terfi ölçümü: research.forward_harness her koşuda data/forward_eval/
# shadow_promote.json yazar, daily_summary "terfiye hazır" satırını basar. Elle:
#   python -m research.shadow_promote --json data/forward_eval/shadow_promote.json

# --- TABAN SİNYAL ONARIMLARI (Tur-39; ölçüm: 510 işlem, PF 0,518) ---
# Sinyal fiyatı df_htf'in son bar KAPANIŞIDIR ve 1h barda ~59 dk bayat olabilir; işlem ise
# canlı fiyattan olur. Ölçüldü: işlemlerin %46'sında MFE tam 0,00 (girilen fiyat piyasada
# YOK) ve GAP_STOP sınıfı 68/68 aleyhte, -299.438 $ = tüm net zarardan büyük.
# AÇIK: giriş canlı fiyata çapalanır, RR yeniden hesaplanır, kurulum bayatsa GİRİLMEZ.
LIVE_ENTRY_ANCHOR=true
# Zaman-stopu ufku DAKİKA cinsinden. Eskiden `time_stop_bars` canlıda ~60 sn'lik quote
# yoklamalarını sayıyordu → 12 "bar" 12 DAKİKA ediyordu, oysa 2R hedefi 1h geometriden
# türer. 510 işlemin 405'i bu yüzden ~17 dk'da TIME_STOP ile ve +0,14R'de kesildi.
TIME_STOP_MINUTES=90
# Seans kapanışına bu kadar dakika kala açık pozisyon kapatılır → gecelik gap riski YOK.
# 0 = kapalı (gecelik taşımaya izin verir; ayrı boyut/hedge kuralı ister).
FLAT_BEFORE_CLOSE_MIN=10

# --- GÖLGE SİNİR AĞI KABLOSU (Tur-41; nihai/ai/shadow_runner.py) ---
# Gölge artefaktı: BOŞ bırakılırsa DATA_DIR'daki en yeni UYUMLU `neural_*` manifesti
# seçilir. ŞEMA KAPISI zorunludur: feature_names canlı şemayla eşleşmezse artefakt
# ATLANIR (brain eksik özelliği 0.0 doldurur; uyumsuz model gürültüyü p_win diye taşırdı).
# Model KARAR VERMEZ — gölge p_win ± std, decision.resolve_mode() disiplininde.
AI_NEURAL_MODEL=
# Koşu başında ^VIX önbelleğini BİR KEZ ısıt. 0 = kapalı. Isıtma olmadan taze süreçte
# features=None kalır ve ÖNGÖR adımı model yüklense bile PASİF kalır. Başarısız olursa
# VIX nötr 18.0'a düşer, koşu sürer (ısıtma bir kolaylıktır, kapı değildir).
AI_SHADOW_WARM_VIX=1

# --- Sinyal/strateji ek bayrakları (hepsi varsayılan değerinde) ---
LONG_ONLY=false                    # true → SHORT sinyalleri bastırılır
QUANT_KISA=false                   # Tur-97 quant_trend kısa bacağı (hisse piyasalarında zarar yazdı → kapalı)
TREND_STOP_ATR=1.5                 # trend stratejileri: stop mesafesi (ATR katı)
TREND_TARGET_ATR=3.0               # trend stratejileri: hedef mesafesi (ATR katı)
GATE_TREND_ALIGN=false             # HTF trend-hizası kapısı (A/B'de expectancy DÜŞÜRDÜ → kapalı)
GATE_ADX_FLOOR=false               # ADX taban kapısı (A/B'de expectancy DÜŞÜRDÜ → kapalı)
VIX_GATE=false                     # yüksek-VIX'te yeni giriş bastır (dayanıklı doğrulanmadı → kapalı)
VIX_HIGH=28                        # VIX_GATE eşiği (önceki gün kapanışı, look-ahead-güvenli)
SETUP_EXT_INDICATORS_ENABLED=false # setup_score'a genişletilmiş gösterge oyları ekle
SETUP_EXT_WEIGHT=1.0               # genişletilmiş gösterge oylarının ağırlığı
SIGNAL_ALERT_ALWAYS=true           # sinyal uyarısını risk onayından BAĞIMSIZ gönder (sinyal-only)

# --- PDT / takas / wash-sale (Madde 10, 23, 30, 53) ---
# PDT ön-kontrolü varsayılan AÇIK. Tur-62'den beri yeni GİRİŞİ de engeller
# (yalnız NLV < PDT_THRESHOLD_EQUITY iken). 0/false = kapat; broker yine uygular.
PDT_ENABLED=true
PDT_THRESHOLD_EQUITY=25000.0       # PDT eşiği (USD)
PDT_LOOKBACK_DAYS=5                # day-trade sayım penceresi (TAKVİM günü; FINRA iş günü der)
PDT_MAX_DAY_TRADES_UNDER_THRESHOLD=3   # FINRA değeri (Tur-62: eskiden 10'du, gerekçesizdi)
SETTLEMENT_DAYS=1                  # T+1 (28 May 2024'ten beri)
SSR_TRIGGER_DROP_PCT=0.10          # SSR (Reg SHO 201): önceki kapanışa göre düşüş eşiği
WASH_SALE_DAYS=30                  # wash-sale penceresi (gün)

# --- Sentiment tarihçe toplayıcı (main döngüsü; C2'den ayrı knob) ---
SENTIMENT_COLLECT=false            # true → sentiment geçmişini periyodik diske biriktir
SENTIMENT_REFRESH_MIN=60           # toplama aralığı (dk)

# --- Oto-tarayıcı ek knob'ları ---
AUTO_SCREEN_EXECUTOR=process       # process | thread (paralel tarama yürütücüsü)
# AUTO_SCREEN_WORKERS=8            # boşsa min(16, cpu_count) kullanılır
# AUTO_SCREEN_INTERVAL_HOURS=      # saat cinsinden aralık; AUTO_SCREEN_INTERVAL_MINUTES öncelikli

# --- LLM olay/haber analizi (nihai/data/llm_event.py; opsiyonel) ---
# Boş anahtar → modül sessizce devre-dışı (sinyal akışı etkilenmez).
LLM_EVENT_PROVIDER=anthropic       # anthropic | gemini
LLM_EVENT_MODEL=claude-opus-4-8    # anthropic model adı
LLM_EVENT_MAX_CHARS=12000          # LLM'e gönderilecek metin tavanı
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                    # gemini için (GOOGLE_API_KEY de kabul edilir)
GEMINI_MODEL=gemini-2.5-flash

# --- Log güvenliği ---
LOG_TRUNCATE_MAX_BYTES=52428800    # tek log dosyası tavanı (50MB); aşan kırpılır

# --- Forward/ileri değerlendirme (research/forward_harness.py + web pano sekmesi) ---
FORWARD_MIN_DAYS=10                # değerlendirme için min takvim günü
FORWARD_MIN_RESOLVED=500           # min çözülmüş tahmin sayısı
FORWARD_EDGE_PP=3.0                # 'kenar var' demek için isabet − %50 eşiği (puan)
FORWARD_TEST_TARGET_DAYS=14        # web pano forward-test hedef gün sayısı
GATE_SIM_MIN_SIDE=30               # meta-kapı CANLI simülasyonu örneklem kapısı: tutulan VE
                                   # elenen tarafta bundan az çözülmüş aday varsa hüküm YOK
                                   # (INSUFFICIENT) — gürültüde desen görme tuzağına karşı

# ---------------------------------------------------------------------------
# Tur-59 — dış rapor triyajı #2 (hepsi OPSİYONEL; varsayılanlar davranışı korur)
# ---------------------------------------------------------------------------
# BULGU-59-1 — canlı ÖZELLİK logu politikası. true (varsayılan) = taranan HER bar
# yazılır (etiketsiz ön-eğitim havuzu ~8× büyür); false = yalnız aday barları (eski).
# Aday-DIŞI satırlar `cand_side` kolonunda BOŞ görünür.
FEATURE_LOG_ALL=true

# BULGU-59-2 — intra-bar sıra politikası. open_evidence (varsayılan) = bar AÇILIŞI iki
# yönde de sıra kanıtıdır (GAP_STOP + GAP_TARGET); stop_first = Tur-58 davranışı (A/B).
INTRABAR_POLICY=open_evidence

# BULGU-78-1 — çıkış sonrası yeniden giriş (backtest). next_bar (varsayılan) = bar i+1'in
# İÇİNDE kapanan pozisyonun sembolünde aynı iterasyonda giriş YOK (bar i kapanışındaki karar o
# pozisyonu açık görürdü; en erken giriş bar i+2 açılışı). same_bar = eski döngü, yalnız A/B.
REENTRY_POLICY=next_bar

# BULGU-59-3 — hacim katılımına duyarlı piyasa etkisi katsayısı eta
# (kayma = taban + eta*sigma*sqrt(Q/ortalama_bar_hacmi)). 0 = hacim etkisi KAPALI.
# Backtest ve sanal döngü aynı ayarı okur. Ölçülen kote varsa taban yarım makastır;
# OHLCV'de kote yoksa sabit kayma kesri kullanılır. Hacim ve ATR aynı bar ufkundadır.
# Literatür aralığı 0,3-1,0 (Almgren 2005) ama bu evrende ÖLÇÜLMEMİŞTİR → duyarlılık
# aracı olarak kullan, varsayılan yapma.
IMPACT_COEF=0

# BULGU-59-6 — beta ölçümü için benchmark bar önbelleğinin ömrü (saniye).
BETA_BENCH_TTL_SEC=1800

# BULGU-59-7 — çapraz varlık vekillerinin (TLT/UUP/USO) yenilenme aralığı (saniye).
CROSS_ASSET_TTL_SEC=900

# Opsiyon zinciri ARŞİVİ (python -m nihai.data.option_archive)
# Varsayılan dizin data/option_archive (OneDrive İÇİNDE = bilinçli: bu arşiv yeniden
# ÜRETİLEMEZ, senkron bir maliyet değil YEDEKTİR).
# OPTION_ARCHIVE_DIR=C:\Users\Kagan\option_archive
OPTION_ARCHIVE_SYMBOLS=SPY,QQQ

# ÖLÜ ADAM ANAHTARI (python -m nihai.notifier.deadman --send --ping)
# Bayatlık eşiklerine eklenen tolerans (dk) ve dış "hâlâ hayattayım" ping adresi.
DEADMAN_GRACE_MIN=5
# DEADMAN_SNITCH_URL=https://nosnch.in/xxxxxxxx

# ===========================================================================
# BULGU-61-3 (Tur-61) — ÜRETİM KODUNUN OKUDUĞU AMA HİÇBİR YERDE BELGELENMEMİŞ
# AYARLAR. Denetim: `.env.example`te 187 ad tanımlıydı ve hepsi kodda okunuyordu
# (ters yön temizdi), ama kodun okuduğu 23 ad HİÇBİR belgede (bu dosya + CLAUDE.md)
# geçmiyordu. Belgesiz bir düğme çevrilmeyen düğmedir: Tur-60'ın kendi raporu
# operatöre "NEURAL_SHADOW açık kalsın" diyordu ve o ad bu dosyada YOKTU.
# Değerler kodun VARSAYILANLARIDIR — satırları açmak davranışı değiştirmez.
# `tests/test_tur61_kopru_ve_belge.py` bu listeyi kilitler: kodda yeni bir env
# okuması doğarsa ve buraya yazılmazsa test KIRMIZI olur.
# ===========================================================================

# --- Gölge/nöral yüzeyler (Tur-18/37) ---
# Nöral gölge p_win KAYDI (karar-dışı). Tur-60 §7.3: terfi tartışmasının önündeki tek
# darboğaz kanıt birikimidir → açık bırakmanın gerekçesi kenar değil ÖRNEKLEMDİR.
NEURAL_SHADOW=on
NEURAL_SHADOW_MC_PASSES=20          # MC-dropout geçiş sayısı (belirsizlik bandı)
NEURAL_SHADOW_MAX_Z=6.0             # özellik z-kırpma tavanı ("off" → kırpma yok)
# NEURAL_SHADOW_MODEL=              # boş → registry'den seçilir; ad verilirse O model
NEURAL_SHADOW_DEVICE=auto           # Tur-93: auto → deep_mlp CPU, büyük basamak (282M) CUDA varsa GPU + toplu MC | cpu | cuda
# --- Sinir agi egitim cihazi (OPT-IN; varsayilan CPU = bit-denk eski davranis) ---
# GPU/bf16 kayan-nokta sonucunu DEGISTIRIR: ayni seed farkli donanimda farkli agirlik
# uretir. Bu yuzden varsayilan "cpu" ve acmak operatorun karari.
# OLCULDU (RTX 4070 Laptop, n=4000 x f=96, 2 epoch): quant_transformer 5,47M param
#   cpu 305,25 s -> gpu 6,21 s (49,1x) -> gpu+amp 3,36 s (90,9x)
#   deep_mlp 0,22M param: gpu 1,47x AMA gpu+amp 0,48x (YAVASLADI) -> amp kucuk tier'da
#   koddan kisilir, asagidaki anahtar onu ACAMAZ.
NEURAL_DEVICE=cpu                   # cpu | auto | cuda | cuda:N  (auto: CUDA yoksa sessizce cpu)
NEURAL_AMP=0                        # 1 -> bf16 autocast (yalniz CUDA'da ve deep_mlp DISI tier'larda)
AI_OBSERVATORY=on                   # gözlemevi gölge paketi (mikroyapı+HAR-RV+HMM+sağlık)
AI_OBS_HMM_REFIT_BARS=60            # NEDENSEL rejim HMM'inin yeniden-fit periyodu (bar)

# --- İç-AI defterleri: budama sınırları (dosya şişmesini önler) ---
AI_MEMORY_KEEP_LINES=2000
AI_MEMORY_MAX_BYTES=5242880
AI_EPISODES_KEEP_LINES=2000
AI_EPISODES_MAX_BYTES=5242880
AI_EPISODE_HORIZON_BARS=5           # bölüm çözümünde ileri bar sayısı
AI_EPISODE_MIN_ABS_RET=0.0          # |getiri| bu eşiğin altındaysa bölüm NÖTR sayılır
AI_REASONER_PRED_TAIL=500           # akıl yürütücünün okuduğu predictions_log kuyruğu
AI_REASONER_GAP_HOURS=26            # bu kadar saat kayıt yoksa "kanıt akışı durdu" der
AI_ROUTER_COOLDOWN_HOURS=6          # LLM sağlayıcı hatasından sonra bekleme
AI_PRIOR_SIDE=on                    # off → yön-özel prior kapatılır (GLOBAL prior kalır)
# AI_UTILITY_LAMBDA=                # research/shadow_decision_backtest süpürmesi kullanır

# --- Alpaca TARİHSEL (research; canlı akıştan AYRI yol) ---
ALPACA_HIST_FEED=sip                # sip | iex — PIT evreni SIP ister (delist'ler dahil)
ALPACA_HIST_ADJUSTMENT=all          # bölünme+temettü düzeltmesi
ALPACA_HIST_CACHE_MAX_AGE_DAYS=1    # bugünkü diliminin önbellek ömrü (gün)
# ALPACA_HIST_DIR=                  # boş → data/alpaca_hist

# --- DoltHub opsiyon deposu (ÜCRETSİZ, anahtarsız) ---
DOLT_OPTIONS_REPO=post-no-preference/options
DOLT_OPTIONS_BRANCH=master          # DİKKAT: bu depoda 'main' dalı YOKTUR

# --- Diğer ---
HUB_BREAKER_SEC=30                  # ölü hub'a yeniden bağlanma denemesi arası (devre kesici)
RESOLVE_FETCH_WORKERS=8             # tahmin çözümünde paralel bar çekimi (1 = eski sıralı davranış; Tur-81)
IV_COLLECT_MIN=15                   # WAIT taramalarında zincir/IV örnekleme aralığı, dk (Tur-82)
QUOTE_SANITY_PCT=3.0                # canlı kotenin son bar kapanışından azami sapması (%)
# CHART_LLM_PROVIDER=               # boş → AI_ROUTER sağlayıcısı (/yorum grafik okuma)
# CHART_LLM_MODEL=                  # boş → sağlayıcı varsayılanı
# QUANDL_API_KEY=                   # NASDAQ_DATA_LINK_API_KEY'in eski adı (Sharadar PIT)

# --- Kip/anahtar/yol: kodda okunuyordu, burada beyanı yoktu ---
AI_DECISION_MODE=shadow             # off | shadow | live — iç-AI karar motoru (canlı .env'de shadow)
# GOOGLE_API_KEY=                   # GEMINI_API_KEY'in eş adı (router + /yorum + llm_event)
LOG_RETENTION_DAYS=30               # python -m nihai.log_retention: gzip'lenen logun saklanma süresi
# Yol/koşum geçersiz kılmaları: pytest bunları geçici dizine çevirir (kök conftest.py,
# BULGU-8/9 — testler ÜRETİM logs/ ve data/'sına yazamaz). Elle kullanmak nadirdir.
# NIHAI_DATA_DIR=
# NIHAI_LOG_DIR=
# NIHAI_DISABLE_FILE_LOG=1
# NIHAI_EDGE_LEDGER=                # kenar-keşif defterinin yolu (DSR n_trials kaynağı)
# NIHAI_REPLAY_WORKER=              # İÇ İŞARET — elle AYARLAMAYIN: `python -m nihai.execution.replay`
#                                   # izole alt süreci kendisi "1" yapar (Tur-77, Madde 6.3; ağ çekimi
#                                   # ve yazma çiti yalnız bu işaretli alt süreçte açılır)

# --- Çoklu piyasa araştırması (Tur-96, research/piyasalar.py + research/coklu_piyasa.py) ---
# PIYASA_CACHE_DIR=                 # 14 piyasa grubunun yfinance günlük önbelleği (vars. ~/nihai_hist/piyasalar;
#                                   # OneDrive DIŞI — araştırma önbelleği senkronlanmaz, Tur-94 ilkesi)
# PIYASA_SONUC_DIR=                 # koşu ara sonuçları (vars. ~/nihai_hist/piyasa_sonuc); karne data/'ya yazılır

# --- Gölge kasalar (Tur-102, nihai/execution/golge_kasalar.py) ---
# Gölgede/danışman olarak çalışan 5 karar mekanizmasına (meta kapı, iç AI, gölge köprüsü, nöral gölge,
# olasılık+güven boyutlama) + mekanizmasız KONTROL kasasına ayrı sanal kasa verir; her kasa kendi
# mekanizmasını ENFORCE kipinde uygular. Canlı portföye/sinyale DOKUNMAZ (KARAR-DIŞI). Tahmin servisinin
# 1m barlarında, yalnız seans açıkken koşar. Rapor: python -m nihai.execution.golge_kasalar
# GOLGE_KASA=on                     # off → hiç çalışmaz (test sürecinde conftest kapatır)
# GOLGE_KASA_STRATEJI=event_breakout  # kasaların ortak aday akışı (mekanizmaların ölçüldüğü 1m TA ailesi)
# GOLGE_KASA_BAKIYE=1000000         # kasa başına başlangıç bakiyesi ($); kasa dosyası varken DEĞİŞTİRMEZ
# GOLGE_KASA_DIR=                   # vars. data/golge_kasalar (kasa JSON'ları, islemler.csv, kararlar.csv)
# GOLGE_KASA_POZ_PAY=0.10          # tek pozisyonun nominal tavanı (kasa özsermayesi payı); boyut çarpanı ondan SONRA
# GOLGE_KASA_YENILEME_SN=15        # yalnız ayrı koşucuda (--kos) tahmin turu aralığı; canlı süreçte PREDICT_REFRESH_SEC
